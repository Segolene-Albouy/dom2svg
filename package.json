{
  "name": "dom2svg",
  "version": "0.1.0",
  "description": "Convert DOM elements to clean, self-contained SVG files. Built for exporting node-based editors to vector graphics.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "dom2svg": "./bin/dom2svg.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts"
  },
  "keywords": [
    "svg",
    "dom",
    "html-to-svg",
    "dom-to-svg",
    "export",
    "screenshot",
    "node-editor",
    "react-flow",
    "svelteflow",
    "vector-graphics",
    "canvas",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milanofthe/dom2svg.git"
  },
  "homepage": "https://github.com/milanofthe/dom2svg",
  "bugs": {
    "url": "https://github.com/milanofthe/dom2svg/issues"
  },
  "author": "milanofthe",
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "puppeteer-core": "^24.37.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
